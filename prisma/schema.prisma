generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  firebaseUid String    @unique
  email       String    @unique
  name        String
  phone       String?   @unique
  phoneVerifiedAt DateTime?
  deliveryAddress String?
  picture     String?
  passwordHash String?
  role        Role      @default(CUSTOMER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
  bookings    Booking[]
  roomReviews RoomReview[]
  deliveryOrders DeliveryOrder[]
}

model OtpVerification {
  id          String     @id @default(cuid())
  identifier  String
  phone       String?
  userId      String?
  orderId     String?
  purpose     OtpPurpose
  otpHash     String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([identifier, purpose, consumedAt])
  @@index([phone, purpose])
  @@index([userId, purpose])
  @@index([orderId, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  USER_PHONE_LOGIN
  USER_PHONE_VERIFY
  PASSWORD_RESET
  DELIVERY_PARTNER_LOGIN
  KITCHEN_LOGIN
  ORDER_PICKUP
  ORDER_DELIVERY
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

model Room {
  id          String    @id @default(cuid())
  title       String
  description String
  price       Int
  imageUrl    String?
  imageUrls   String[]  @default([])
  roomPhotoTypes String[] @default([])
  roomPhotos  Json      @default("[]")
  address     String?
  ownerPhone  String?
  tags        String[]  @default([])
  amenities   String[]  @default([])
  unavailableAmenities String[] @default([])
  sleepTitle  String?
  sleepDescription String?
  latitude    Float?    @db.DoublePrecision
  longitude   Float?    @db.DoublePrecision
  capacity    Int       @default(2)
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  reviews     RoomReview[]
}

model Service {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Int
  imageUrl    String?
  imageUrls   String[]    @default([])
  type        ServiceType
  detailSections Json      @default("[]")
  activityOptions Json     @default("[]")
  requiredDocuments String[] @default([])
  pickupAddress String?
  contactPhone String?
  latitude    Float?      @db.DoublePrecision
  longitude   Float?      @db.DoublePrecision
  ctaLabel    String?
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  roomId           String?
  serviceId        String?
  kind             BookingKind
  quantity         Int           @default(1)
  amount           Int
  paymentProvider  String        @default("SIMULATED")
  paymentReference String?
  paymentStatus    PaymentStatus @default(PENDING)
  activityOptions  Json          @default("[]")
  bookedFor        DateTime?
  checkInDate      DateTime?
  checkOutDate     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  room             Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  service          Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([roomId])
  @@index([serviceId])
  @@index([paymentStatus])
}

model RoomReview {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

enum ServiceType {
  RENT_SCOOTY
  TRIP
  CAMPING
  DRONE_SHOOTING
  OTHER
}

enum BookingKind {
  ROOM
  SERVICE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model DeliveryItem {
  id          String           @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String?
  category    DeliveryCategory
  grocerySection String?
  servingInfo String?
  isAvailable Boolean          @default(true)
  availableQuantity Int        @default(100)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category, isAvailable])
}

model DeliveryOrder {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  userId          String
  items           Json
  totalAmount     Int
  paymentProvider String              @default("SIMULATED")
  paymentReference String?
  paymentStatus   PaymentStatus       @default(PENDING)
  status          DeliveryOrderStatus @default(PENDING)
  deliveryAddress String
  customerPhone   String
  partnerId       String?
  destinationLat  Float?              @db.DoublePrecision
  destinationLng  Float?              @db.DoublePrecision
  pickupOtp       String?
  deliveryOtp     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner         DeliveryPartner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([partnerId])
  @@index([paymentStatus])
  @@index([status])
  @@index([orderNumber])
}

model DeliveryPartner {
  id             String          @id @default(cuid())
  name           String
  phone          String
  vehicleType    String
  isAvailable    Boolean         @default(true)
  currentOrderId String?
  currentLat     Float?          @db.DoublePrecision
  currentLng     Float?          @db.DoublePrecision
  loginOtp        String?
  loginOtpExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orders         DeliveryOrder[]

  @@index([isAvailable])
  @@index([currentOrderId])
  @@unique([phone])
}

enum DeliveryCategory {
  FOOD
  GROCERY
}

enum DeliveryOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

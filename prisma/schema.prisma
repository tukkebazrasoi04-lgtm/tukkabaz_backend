generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  firebaseUid     String           @unique
  email           String           @unique
  name            String
  picture         String?
  role            Role             @default(CUSTOMER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  passwordHash    String?
  phone           String?          @unique
  phoneVerifiedAt DateTime?
  deliveryAddress String?
  pushToken       String?
  bookings        Booking[]
  deliveryOrders  DeliveryOrder[]
  deliveryPartner DeliveryPartner?
  roomReviews     RoomReview[]
  sessions        Session[]
}

model OtpVerification {
  id         String     @id @default(cuid())
  identifier String
  purpose    OtpPurpose
  otpHash    String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  phone      String?
  userId     String?
  orderId    String?

  @@index([identifier, purpose, consumedAt])
  @@index([phone, purpose])
  @@index([userId, purpose])
  @@index([orderId, purpose])
  @@index([expiresAt])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Room {
  id                   String       @id @default(cuid())
  title                String
  description          String
  price                Int
  imageUrl             String?
  capacity             Int          @default(2)
  available            Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  address              String?
  latitude             Float?
  longitude            Float?
  ownerPhone           String?
  tags                 String[]     @default([])
  imageUrls            String[]     @default([])
  amenities            String[]     @default([])
  unavailableAmenities String[]     @default([])
  sleepTitle           String?
  sleepDescription     String?
  roomPhotoTypes       String[]     @default([])
  roomPhotos           Json         @default("[]")
  googleMapUrl         String?
  bookings             Booking[]
  reviews              RoomReview[]
}

model Service {
  id                String      @id @default(cuid())
  title             String
  description       String
  price             Int
  imageUrl          String?
  type              ServiceType
  available         Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  imageUrls         String[]    @default([])
  detailSections    Json        @default("[]")
  requiredDocuments String[]    @default([])
  pickupAddress     String?
  contactPhone      String?
  latitude          Float?
  longitude         Float?
  ctaLabel          String?
  activityOptions   Json        @default("[]")
  bookings          Booking[]
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  roomId           String?
  serviceId        String?
  kind             BookingKind
  quantity         Int           @default(1)
  amount           Int
  paymentProvider  String        @default("SIMULATED")
  paymentReference String?
  paymentStatus    PaymentStatus @default(PENDING)
  bookedFor        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  checkInDate      DateTime?
  checkOutDate     DateTime?
  activityOptions  Json          @default("[]")
  room             Room?         @relation(fields: [roomId], references: [id])
  service          Service?      @relation(fields: [serviceId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([roomId])
  @@index([serviceId])
  @@index([paymentStatus])
}

model RoomReview {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

model DeliveryItem {
  id                String           @id @default(cuid())
  name              String
  price             Int
  imageUrl          String?
  category          DeliveryCategory
  isAvailable       Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  availableQuantity Int              @default(100)
  grocerySection    String?
  servingInfo       String?
  pieces            String?
  isVeg             Boolean          @default(true)

  @@index([category, isAvailable])
}

model DeliveryOrder {
  id               String              @id @default(cuid())
  userId           String
  items            Json
  totalAmount      Int
  status           DeliveryOrderStatus @default(PENDING)
  deliveryAddress  String
  customerPhone    String
  partnerId        String?
  destinationLat   Float?
  destinationLng   Float?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  pickupOtp        String?
  deliveryOtp      String?
  orderNumber      String              @unique
  paymentProvider  String              @default("SIMULATED")
  paymentReference String?
  paymentStatus    PaymentStatus       @default(PENDING)
  isPayoutCleared  Boolean             @default(false)
  partnerCut       Int                 @default(50)
  payoutReference  String?
  partner          DeliveryPartner?    @relation(fields: [partnerId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([partnerId])
  @@index([paymentStatus])
  @@index([status])
  @@index([orderNumber])
}

model DeliveryPartner {
  id                String               @id @default(cuid())
  name              String
  phone             String?
  vehicleType       String
  isAvailable       Boolean              @default(true)
  currentOrderId    String?
  currentLat        Float?
  currentLng        Float?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  dlUrl             String?
  profileStatus     PartnerProfileStatus @default(INCOMPLETE)
  payoutRequestedAt DateTime?
  upiId             String?
  profilePhotoUrl   String?
  pushToken         String?
  email             String?              @unique
  userId            String?              @unique
  isOnline          Boolean              @default(false)
  rejectionReason   String?
  orders            DeliveryOrder[]
  user              User?                @relation(fields: [userId], references: [id])

  @@index([phone])
  @@index([isAvailable])
  @@index([currentOrderId])
  @@index([profileStatus])
}

enum OtpPurpose {
  USER_PHONE_LOGIN
  USER_PHONE_VERIFY
  DELIVERY_PARTNER_LOGIN
  KITCHEN_LOGIN
  ORDER_PICKUP
  ORDER_DELIVERY
  PASSWORD_RESET
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

enum ServiceType {
  RENT_SCOOTY
  DRONE_SHOOT
  CAMPING
  TREKKING_WITH_CAMPING
  CAB_AND_TAXI
  CAFE
}

enum BookingKind {
  ROOM
  SERVICE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PartnerProfileStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryCategory {
  FOOD
  GROCERY
}

enum DeliveryOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
